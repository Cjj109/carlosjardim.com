# Cloudflare Pages Headers - Optimización Ultra Rápida
# https://developers.cloudflare.com/pages/platform/headers/

# Headers globales para todos los archivos
/*
  # Seguridad
  #
  # Fuera X-XSS-Protection: la cabecera está obsoleta, ningún navegador
  # moderno la mira y el filtro que activaba en los que quedan ha sido en sí
  # mismo un agujero. Lo que protege de verdad es la CSP de más abajo.
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

  # Performance
  X-DNS-Prefetch-Control: on

# HTML - Siempre revalidar para que los cambios se vean inmediatamente
/*.html
  Cache-Control: no-cache, must-revalidate
  Content-Type: text/html; charset=utf-8

# La calculadora se sirve sin extensión, así que la regla de arriba no la
# cubría: le tocaba el valor por defecto de Cloudflare y Safari lo trataba
# como cacheable. Por eso en iPhone seguía saliendo la versión anterior
# mientras en Chrome ya salía la nueva.
/calculadora
  Cache-Control: no-cache, must-revalidate
  Content-Type: text/html; charset=utf-8
  # La calculadora no carga nada de fuera: ni fuentes de Google, ni scripts,
  # ni imágenes de terceros. Al declararlo, cualquier cosa inyectada que
  # intente salir a otro dominio se queda en el sitio.
  #
  # 'unsafe-inline' en script-src es por los dos <script> de la cabecera —el
  # del tema y el del service worker—, que tienen que ir en línea para
  # ejecutarse antes de que pinte nada.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'; object-src 'none'

# La página de acceso tampoco lleva extensión, así que ni la regla de *.html
# ni la de /calculadora la cubrían: se quedaba con el valor por defecto de
# Cloudflare. Es el mismo caso que dejó la calculadora vieja en Safari, y aquí
# duele más: una copia guardada del acceso es una copia de la pantalla donde
# se firma con la passkey y donde sale el enlace de invitación.
/acceso
  Cache-Control: no-store, must-revalidate
  Content-Type: text/html; charset=utf-8
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow

/
  Cache-Control: no-cache, must-revalidate
  Content-Type: text/html; charset=utf-8

# CSS/JS - Caché corta con revalidación: ya no se versionan las URLs
/css/*
  # 10 minutos de caché y revalidación en segundo plano. Antes iba con
  # max-age de un año e "immutable", lo que obligaba a cambiar la URL con
  # ?v=<fecha> en cada despliegue: hacían falta dos despliegues para que un
  # cambio llegara, y cada uno forzaba a redescargar los 400 KB de golpe.
  # Cloudflare ya manda ETag en estos archivos, así que la revalidación
  # cuesta un 304 de ~150 bytes y solo se baja lo que cambió.
  #
  # El margen de "servir viejo mientras actualizo" es de 10 minutos y no de un
  # día: con un día, alguien podía seguir viendo la versión anterior mucho
  # después de un cambio, que es justo lo que pasó con la calculadora.
  Cache-Control: public, max-age=600, stale-while-revalidate=600
  Content-Type: text/css; charset=utf-8

/js/*
  Cache-Control: public, max-age=600, stale-while-revalidate=600
  Content-Type: application/javascript; charset=utf-8

# Fuentes auto-hospedadas. El nombre del archivo lleva la familia y el
# subconjunto, y ninguno de los dos cambia nunca: si algún día hay una versión
# nueva, será otro archivo. Por eso immutable a un año.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff2
  Access-Control-Allow-Origin: *

# Imágenes (si se agregan en el futuro)
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg

/*.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/*.gif
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/gif

# Favicon
/favicon.ico
  Cache-Control: public, max-age=86400
  Content-Type: image/x-icon

# Data files (JSON) - Cache corto para datos dinámicos como gym stats
/data/*
  Cache-Control: public, max-age=300, must-revalidate
  Content-Type: application/json; charset=utf-8

# La app instalable de la calculadora
# El service worker nunca se cachea: es quien decide qué se guarda y qué no,
# y una copia vieja dejaría la app congelada en una versión anterior.
/sw-calculadora.js
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/javascript; charset=utf-8

/calculadora-app/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8
