# Cloudflare Pages Headers - Optimización Ultra Rápida
# https://developers.cloudflare.com/pages/platform/headers/

# Headers globales para todos los archivos
/*
  # Seguridad
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

  # Performance
  X-DNS-Prefetch-Control: on

# HTML - Siempre revalidar para que los cambios se vean inmediatamente
/*.html
  Cache-Control: no-cache, must-revalidate
  Content-Type: text/html; charset=utf-8

/
  Cache-Control: no-cache, must-revalidate
  Content-Type: text/html; charset=utf-8

# CSS/JS - Caché corta con revalidación: ya no se versionan las URLs
/css/*
  # 10 minutos de caché y revalidación en segundo plano. Antes iba con
  # max-age de un año e "immutable", lo que obligaba a cambiar la URL con
  # ?v=<fecha> en cada despliegue: hacían falta dos despliegues para que un
  # cambio llegara, y cada uno forzaba a redescargar los 400 KB de golpe.
  # Cloudflare ya manda ETag en estos archivos, así que la revalidación
  # cuesta un 304 de ~150 bytes y solo se baja lo que cambió.
  #
  # El margen de "servir viejo mientras actualizo" es de 10 minutos y no de un
  # día: con un día, alguien podía seguir viendo la versión anterior mucho
  # después de un cambio, que es justo lo que pasó con la calculadora.
  Cache-Control: public, max-age=600, stale-while-revalidate=600
  Content-Type: text/css; charset=utf-8

/js/*
  Cache-Control: public, max-age=600, stale-while-revalidate=600
  Content-Type: application/javascript; charset=utf-8

# Fonts (si se agregan en el futuro)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Imágenes (si se agregan en el futuro)
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/jpeg

/*.png
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/png

/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/*.gif
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/gif

# Favicon
/favicon.ico
  Cache-Control: public, max-age=86400
  Content-Type: image/x-icon

# Data files (JSON) - Cache corto para datos dinámicos como gym stats
/data/*
  Cache-Control: public, max-age=300, must-revalidate
  Content-Type: application/json; charset=utf-8

# La app instalable de la calculadora
# El service worker nunca se cachea: es quien decide qué se guarda y qué no,
# y una copia vieja dejaría la app congelada en una versión anterior.
/sw-calculadora.js
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/javascript; charset=utf-8

/calculadora-app/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8
