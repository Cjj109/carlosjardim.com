# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Node
node_modules/
npm-debug.log*

# Temporal
*.log
*.tmp

# Secretos para las funciones en local (claves de API). En producción van como
# variables de entorno del proyecto en Cloudflare, nunca en el repo.
.dev.vars
.dev.vars.*
.env
.env.*
# Estado local de wrangler (caché de miniflare, trazas). Se regenera solo.
.wrangler/

# Los .woff2 sin recortar. Se guardan para poder volver a subsetear sin
# bajarlos de Google, pero no se despliegan: estuvieron en fonts/ y _headers
# los servía en público con immutable a un año.
fuentes-originales/
